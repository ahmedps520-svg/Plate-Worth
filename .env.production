# Public settings for the production build that is published to GitHub Pages.
# Nothing here is secret:
#  - VITE_FORGEBASE_ANON_KEY is ForgeBase's browser-safe "anon" key (same idea
#    as Supabase's). It can only call the project's public endpoints, and the
#    project's CORS settings only accept browsers on the origins listed there.
#  - The Anthropic API key is NOT here; it lives only in ForgeBase
#    (PlateWorth project → API & Keys → Env & secrets → ANTHROPIC_API_KEY).
BASE_PATH=/Plate-Worth/
VITE_ESTIMATE_URL=https://api.forgebase.art/p/bdvrinzgnqrlflonrgiv/functions/v1/estimate
