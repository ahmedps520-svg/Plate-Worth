{
  "name": "plateworth",
  "private": true,
  "version": "1.0.0",
  "description": "Scan Saudi license plates and get AI-estimated vehicle and plate values in SAR. Static PWA on GitHub Pages + ForgeBase edge function.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:function": "vite build --config vite.function.config.ts",
    "deploy:function": "npm run build:function && node scripts/deploy-forgebase.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
