# ---------------------------------------------------------------------------
# PlateWorth server configuration. Copy to `.env` for local dev, and set the
# same variables in Vercel → Project → Settings → Environment Variables.
# None of these are ever sent to the browser.
# ---------------------------------------------------------------------------

# Required. Your Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Claude model. Defaults to the current Sonnet.
CLAUDE_MODEL=claude-sonnet-5-5

# --- Optional tuning --------------------------------------------------------

# Reasoning effort: low | medium | high | xhigh | max (default: medium).
# Higher = more careful plate reading/pricing, but slower and more tokens.
# CLAUDE_EFFORT=medium

# Output token cap per Claude request, thinking included (default: 32000).
# CLAUDE_MAX_TOKENS=32000

# Server-side refusal fallback (beta) for models that support it: auto | on | off
# (default: auto = on for claude-sonnet-5-5 / claude-opus-5-5 / claude-opus-5 / claude-fable-5-x).
# CLAUDE_REFUSAL_FALLBACK=auto

# Web search tool version: web_search_20250305 (default) or web_search_20260209
# (newer; adds dynamic result filtering on Sonnet 5.5 / Opus 4.6+).
# WEB_SEARCH_TOOL_VERSION=web_search_20250305

# Max web searches per estimate (1-10, default: 5).
# WEB_SEARCH_MAX_USES=5

# Optional comma-separated allowlist of domains for web search, e.g.
# haraj.com.sa,syarah.com,motory.com,ksa.yallamotor.com
# Leave empty to let Claude search the whole web (localized to Saudi Arabia).
# WEB_SEARCH_ALLOWED_DOMAINS=

# --- Abuse protection --------------------------------------------------------

# Requests allowed per IP per window (defaults: 10 per 600 seconds).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_SECONDS=600

# Max decoded size per uploaded image in bytes (default: 4194304 = 4 MB).
# MAX_IMAGE_BYTES=4194304

# Optional comma-separated list of allowed browser origins. When set, requests
# from any other Origin are rejected (e.g. https://plateworth.vercel.app).
# ALLOWED_ORIGINS=

# Optional: durable, cross-instance rate limiting with Upstash Redis (REST).
# Without these, a per-instance in-memory limiter is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Local dev only ----------------------------------------------------------

# Set to "false" to run the dev server over plain HTTP (camera then only
# works on http://localhost, not from a phone on your LAN).
# DEV_HTTPS=true
