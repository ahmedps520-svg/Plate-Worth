# ---------------------------------------------------------------------------
# Server settings for the estimate endpoint.
#
#  - Local dev: copy this file to `.env`; `npm run dev` serves /api/estimate.
#  - Production: set the same names in ForgeBase → PlateWorth project →
#    API & Keys → Env & secrets (mark ANTHROPIC_API_KEY as a secret).
#
# None of these ever reach the browser. (Public build settings for GitHub
# Pages live in .env.production.)
# ---------------------------------------------------------------------------

# Required. Your Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Claude model. Defaults to the current Sonnet.
CLAUDE_MODEL=claude-sonnet-5-5

# --- Optional tuning --------------------------------------------------------

# Reasoning effort: low | medium | high | xhigh | max (default: medium).
# CLAUDE_EFFORT=medium

# Output token cap per Claude request, thinking included (default: 32000).
# CLAUDE_MAX_TOKENS=32000

# Server-side refusal fallback (beta): auto | on | off (default: auto).
# CLAUDE_REFUSAL_FALLBACK=auto

# Web search tool version: web_search_20250305 (default) or web_search_20260209.
# WEB_SEARCH_TOOL_VERSION=web_search_20250305

# Max web searches per estimate (1-10, default: 5).
# WEB_SEARCH_MAX_USES=5

# Optional comma-separated allowlist of domains for web search.
# WEB_SEARCH_ALLOWED_DOMAINS=haraj.com.sa,syarah.com,motory.com,ksa.yallamotor.com

# Time budget for one estimate in ms (default 110000; ForgeBase functions stop at 120 s).
# ESTIMATE_DEADLINE_MS=110000

# --- Abuse protection --------------------------------------------------------

# Scans allowed per IP per window (defaults: 10 per 600 seconds).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_SECONDS=600

# Total scans per UTC day for everyone together (default 100; 0 = no cap).
# Protects your Anthropic bill on a public site.
# DAILY_SCAN_LIMIT=100

# Max decoded size per uploaded image in bytes (default: 4194304 = 4 MB).
# MAX_IMAGE_BYTES=4194304

# Only for hosts without their own CORS handling (ForgeBase handles CORS from
# the project's API settings, so leave this unset there).
# ALLOWED_ORIGINS=

# --- Local dev only ----------------------------------------------------------

# Set to "false" to run the dev server over plain HTTP.
# DEV_HTTPS=true
